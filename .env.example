# Copy to .env for local runs. Coolify injects these in production. Never commit real values.

# Public origin, no trailing slash. WebAuthn and cookies use this exact value.
ORIGIN=https://pokedex.folderr.co

# SQLite file. Mount a volume at /data in Coolify.
DATABASE_PATH=/data/pokedex.db

# Bearer token for BALTHA. 32+ random bytes, hex or base64url. Compared in constant time.
# Also the default HMAC secret for the decisions webhook.
INGEST_TOKEN=

# From `npm run vapid`. Do not rotate casually — every phone must subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:augusto@folderr.co

# Relying party. Must be the hostname of ORIGIN, no port, no scheme.
WEBAUTHN_RP_ID=pokedex.folderr.co
WEBAUTHN_RP_NAME=Pokedex

# Cookie signing. 32+ random bytes.
SESSION_SECRET=

# Optional. One-time passkey enrollment code used at boot when no passkey exists.
# Remove it from the environment after enrollment.
SETUP_CODE=

# Optional. On each decision answer, POST the answer JSON here.
# Signature header: X-Pokedex-Signature: sha256=<hex hmac of the raw body>.
# HMAC key is DECISIONS_WEBHOOK_SECRET, or INGEST_TOKEN if the secret is unset.
# DECISION_WEBHOOK_URL is accepted as an alias.
DECISIONS_WEBHOOK_URL=
DECISIONS_WEBHOOK_SECRET=

# Display and for_date live in this zone. The server clock can stay UTC.
TZ=America/Sao_Paulo

# Listen address. Coolify / Traefik should target 3000.
PORT=3000
HOST=0.0.0.0

# Set to 1 to load docs/example-payload.json on first boot when the database has no briefs.
SEED_DEMO=0

# Single-user display name created on first boot.
USER_DISPLAY_NAME=Augusto

# Set by the Docker image so Traefik's forwarded headers are trusted.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
